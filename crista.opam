opam-version: "2.0"
synopsis: "A minimalistic HTTP server framework for OCaml 5"
description:
  "A small direct-style server framework for OCaml 5 built on top of the Miou scheduler"
maintainer: ["Akira Komamura <akira.komamura@gmail.com>"]
authors: ["Akira Komamura <akira.komamura@gmail.com>"]
license: "ISC"
tags: ["http" "server" "miou" "picos"]
