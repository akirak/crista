# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Eio backend for Crista"
description: "Run Crista HTTP handlers using Eio"
maintainer: ["Akira Komamura <akira.komamura@gmail.com>"]
authors: ["Akira Komamura <akira.komamura@gmail.com>"]
license: "ISC"
tags: ["http" "server" "eio"]
homepage: "https://github.com/akirak/crista"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.3"}
  "crista" {= version}
  "eio"
  "eio_main"
  "odig" {with-doc}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
